public class ArraySum {
    public static int calculateSum(int[] arr) {
        int sum = 0;
        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
        }
        return sum;
    }

    public static void main(String[] args) {
        int[] numbers = {5, 10, 15, 20};
        System.out.println(calculateSum(numbers));
    }
}
